<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <AssemblyName>request-guard-mcp-dotnet</AssemblyName>
    <UserSecretsId>request-guard-mcp-dotnet</UserSecretsId>
    <!-- Single-file release bundles cannot run in-process under IIS. Out-of-process hosting also
         preserves this server's Kestrel connection guards behind the IIS reverse proxy. -->
    <AspNetCoreHostingModel>OutOfProcess</AspNetCoreHostingModel>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\RequestGuardMcp.Core\RequestGuardMcp.Core.csproj" />
    <ProjectReference Include="..\RequestGuardMcp.Mcp\RequestGuardMcp.Mcp.csproj" />
    <ProjectReference Include="..\RequestGuardMcp.Tools\RequestGuardMcp.Tools.csproj" />
    <ProjectReference Include="..\RequestGuardMcp.Integrations\RequestGuardMcp.Integrations.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="packages.release.lock.json;appsettings.Development.json" CopyToPublishDirectory="Never" />
  </ItemGroup>

</Project>
