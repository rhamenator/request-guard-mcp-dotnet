<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <VersionPrefix>0.1.0</VersionPrefix>
    <Deterministic>true</Deterministic>
    <RepositoryUrl>https://github.com/rhamenator/request-guard-mcp-dotnet</RepositoryUrl>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>

    <!-- Configuration-management baseline (DO-178C-inspired): treat every compiler and
         analyzer warning as a build failure so defects surface at the earliest verification
         stage, matching the Rust project's "cargo clippy, deny warnings" gate. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <AnalysisMode>Recommended</AnalysisMode>

    <IsPackable>false</IsPackable>
    <RootNamespace>$(MSBuildProjectName)</RootNamespace>

    <!-- Per-project packages.lock.json, checked in like Cargo.lock, so CI can restore in
         locked mode and fail if a dependency drifts without an explicit, reviewed bump. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <!-- Native publishing has a separate reviewed lock graph including all supported
         RIDs and the SDK's single-file linker task. Normal builds keep their original lock. -->
    <DebugType Condition="'$(ReleaseBundle)' == 'true'">None</DebugType>
    <DebugSymbols Condition="'$(ReleaseBundle)' == 'true'">false</DebugSymbols>
    <RuntimeIdentifiers Condition="'$(ReleaseBundle)' == 'true'">linux-x64;win-x64;osx-x64;osx-arm64</RuntimeIdentifiers>
    <SelfContained Condition="'$(ReleaseBundle)' == 'true'">true</SelfContained>
    <PublishSingleFile Condition="'$(ReleaseBundle)' == 'true'">true</PublishSingleFile>
    <NuGetLockFilePath Condition="'$(ReleaseBundle)' == 'true'">packages.release.lock.json</NuGetLockFilePath>
  </PropertyGroup>

</Project>
