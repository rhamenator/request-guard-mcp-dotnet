# Copy to .env for local development. Replace placeholders; never commit .env.
MCP__HOST=0.0.0.0
MCP__PORT=8085
LOG_LEVEL=Information
AUTH_TOKENS=replace_me_with_a_strong_token
CACHE_SCOPE_HMAC_KEY=replace_me_with_32_or_more_random_bytes
REDIS_PASSWORD=replace_me
POSTGRES_PASSWORD=replace_me

MCP__LIMITS__MAX_REQUEST_BYTES=1048576
MCP__LIMITS__MAX_BATCH_SIZE=50
MCP__LIMITS__GLOBAL_CONCURRENCY=256
MCP__LIMITS__PER_TOOL_TIMEOUT_SECS=30
MCP__LIMITS__CLASSIFY_TIMEOUT_SECS=5

# MCP__REDIS__URL=redis://localhost:6379
MCP__REDIS__KEY_PREFIX=request_guard
MCP__REDIS__CACHE_TTL_SECS=300
# MCP__POSTGRES__URL=Host=localhost;Port=5432;Database=mcp;Username=mcp;Password=replace_me
# MCP__GEOIP__CITY_MMDB_PATH=/data/GeoLite2-City.mmdb
# MCP__GEOIP__ASN_MMDB_PATH=/data/GeoLite2-ASN.mmdb
# MCP__GEOIP__ANONYMOUS_IP_MMDB_PATH=/data/GeoIP2-Anonymous-IP.mmdb

MCP__FEATURES__ENABLE_BATCH=true
MCP__FEATURES__ENABLE_ENRICHMENT=true
MCP__FEATURES__ENABLE_FEEDBACK=true
MCP__TELEMETRY__METRICS_PATH=/metrics
# MCP__TELEMETRY__OTLP_ENDPOINT=http://otel-collector:4317

# TLS_FINGERPRINT_ATTESTATION_KEY=replace_me_with_32_or_more_random_bytes
# TLS_FINGERPRINT_ATTESTATION_PREVIOUS_KEY=replace_me_with_the_old_random_key
TLS_FINGERPRINT_ATTESTATION_MAX_AGE_SECONDS=60
# TLS_KNOWN_BAD_JA3=72a589da586844d7f0818ce684948eea
# TLS_KNOWN_BAD_JA4=t13d1516h2_8daaf6152771_e5627efa2ab1
